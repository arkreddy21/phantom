HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
# Required single-owner application login. Replace these placeholders with unique,
# strong credentials; keep the resulting .env file private and out of Git.
# For passwords containing '$', use a single-quoted value in .env so Compose
# treats the password literally: AUTH_PASSWORD='your$password'.
AUTH_USERNAME=replace-with-your-username
AUTH_PASSWORD=replace-with-a-long-random-password
# Keep disabled for local/direct access. Enable only behind a trusted proxy.
AUTH_TRUST_PROXY=0
# Optional: set to the exact public http(s) origin when running behind a reverse proxy.
# PUBLIC_ORIGIN=https://your-public-host.example
# Choose the server timezone deliberately; it determines daily dates. UTC is an example, not a default recommendation.
TZ=UTC
