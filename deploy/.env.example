# Replace this with an immutable tag or digest published by the release workflow.
PHANTOM_IMAGE=ghcr.io/owner/phantom:sha-0123456789abcdef0123456789abcdef01234567
PHANTOM_PORT=3100
PUBLIC_ORIGIN=https://phantom.example.com
TZ=UTC
# Choose your private app login; never commit the populated .env file.
AUTH_USERNAME=replace-with-your-username
AUTH_PASSWORD=replace-with-a-long-random-password
# Set to 1 only behind one trusted proxy, with no untrusted direct app access.
AUTH_TRUST_PROXY=0
# Optional host architecture override; default is linux/arm64. Set linux/amd64 for x86_64.
PHANTOM_PLATFORM=linux/arm64
